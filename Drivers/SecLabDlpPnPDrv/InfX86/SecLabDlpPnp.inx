;;;
;;; SecLabDlpPnP
;;;

[Version]
Signature   = "$Windows NT$"
Class       = EpSecLab
ClassGuid   = {17927B9D-6D0B-4B81-A237-E2CF578D73AC}
Provider    = %CompanyName%
PnpLockdown=1

CatalogFile=SecLabDlpPnP.cat
CatalogFile.NTX86 =SecLabDlpPnP.cat
 
[DestinationDirs]
DefaultDestDir         = 12

;;
;; Default install sections
;;

[DefaultInstall.NTX86]
OptionDesc = %DriverName%
CopyFiles = DriverCopyFiles

[SourceDisksNames]
1 = %DiskName%

[DriverCopyFiles]
SecLabDlpPnP.sys

[SourceDisksFiles]
SecLabDlpPnP.sys = 1

[Strings]
DiskName                    = "SecLabDlpPnP Installation Disk"
CompanyName                 = "Ephraim Neuberger"
DriverName                  = "SecLabDlpPnP"
